{
    "name": "turkpin/interview-test",
    "description": "Turkpin Dealer API integration interview project",
    "autoload": {
        "psr-4": {
            "Turkpin\\InterviewTest\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Turkpin DEV Team",
            "email": "devteam@turkpin.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-filter": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
		"ext-session": "*",
        "smarty/smarty": "^5.0",
        "bramus/router": "^1.6",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.64",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit tests",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix",
        "format-check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
